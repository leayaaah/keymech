{
  "info": {
    "name": "Keymech: Custom Requests (Phương)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Chạy theo thứ tự A, B, C, D. Cần: backend chạy ở cổng 8080, tài khoản Customer và Staff (hoặc Admin: vào được khu Staff) đã tồn tại, điền biến collection. Cookie JSESSIONID do Postman tự giữ. otherRequestId là id yêu cầu của một Customer khác; cancelRequestId là id của một yêu cầu PENDING dùng để thử hủy."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "customerEmail",
      "value": ""
    },
    {
      "key": "customerPassword",
      "value": ""
    },
    {
      "key": "staffEmail",
      "value": "admin@keyboardshop.vn"
    },
    {
      "key": "staffPassword",
      "value": ""
    },
    {
      "key": "requestId",
      "value": ""
    },
    {
      "key": "otherRequestId",
      "value": ""
    },
    {
      "key": "cancelRequestId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "A. Customer",
      "item": [
        {
          "name": "Đăng nhập Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Đăng nhập bằng tài khoản trong biến collection. Postman tự giữ cookie JSESSIONID. Endpoint và tên trường do Trí làm; sửa nếu khác."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Mã trạng thái 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "C-03 Gửi yêu cầu Custom",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/custom-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "custom-requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"layout\": \"75%\",\n  \"switchType\": \"Linear - Gateron Yellow\",\n  \"caseMaterial\": \"Nhôm\",\n  \"keycapSet\": null,\n  \"lubing\": true,\n  \"hotSwap\": true,\n  \"rgbOption\": \"RGB\",\n  \"budget\": 3000000,\n  \"note\": \"Muốn gõ êm\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Mã trạng thái 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test('PENDING và có mã CUS-', () => { pm.expect(j.status).to.eql('PENDING'); pm.expect(j.requestCode).to.match(/^CUS-/); });",
                  "pm.collectionVariables.set('requestId', j.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "C-03 Sai dữ liệu: thiếu layout, ngân sách thấp",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/custom-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "custom-requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"switchType\": \"Linear\",\n  \"budget\": 100000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Mã trạng thái 400', () => pm.response.to.have.status(400));",
                  "pm.test('error = VALIDATION_ERROR', () => pm.expect(pm.response.json().error).to.eql('VALIDATION_ERROR'));"
                ]
              }
            }
          ]
        },
        {
          "name": "C-04 Danh sách của tôi",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/custom-requests/my?page=0&size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "custom-requests",
                "my"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Mã trạng thái 200', () => pm.response.to.have.status(200));",
                  "pm.test('có phân trang', () => pm.expect(pm.response.json()).to.have.keys('content','page','size','totalElements','totalPages'));"
                ]
              }
            }
          ]
        },
        {
          "name": "C-04 Chi tiết và tiến độ",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/custom-requests/my/{{requestId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "custom-requests",
                "my",
                "{{requestId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Mã trạng thái 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('dòng lịch sử đầu là PENDING, không có oldStatus', () => { pm.expect(j.history[0].newStatus).to.eql('PENDING'); pm.expect(j.history[0].oldStatus).to.be.undefined; });",
                  "pm.test('khách chỉ thấy Bạn hoặc Cửa hàng', () => j.history.forEach(h => pm.expect(['Bạn','Cửa hàng']).to.include(h.actor)));",
                  "pm.test('không lộ khối customer', () => pm.expect(j.request.customer).to.be.undefined);"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-CUS-11 Đồng ý khi còn PENDING phải 409",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/custom-requests/my/{{requestId}}/accept",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "custom-requests",
                "my",
                "{{requestId}}",
                "accept"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quotedPrice\": 2500000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Mã trạng thái 409', () => pm.response.to.have.status(409));",
                  "pm.test('error = INVALID_TRANSITION', () => pm.expect(pm.response.json().error).to.eql('INVALID_TRANSITION'));"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-CUS-09/10 Xem hoặc đồng ý yêu cầu của người khác (đặt otherRequestId)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/custom-requests/my/{{otherRequestId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "custom-requests",
                "my",
                "{{otherRequestId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Mã trạng thái 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "C-06 Hủy yêu cầu PENDING (chạy ở yêu cầu riêng)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/custom-requests/my/{{cancelRequestId}}/decline",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "custom-requests",
                "my",
                "{{cancelRequestId}}",
                "decline"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Đổi ý\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Mã trạng thái 200', () => pm.response.to.have.status(200));",
                  "pm.test('CANCELLED', () => pm.expect(pm.response.json().status).to.eql('CANCELLED'));"
                ]
              }
            }
          ]
        }
      ]
    },
